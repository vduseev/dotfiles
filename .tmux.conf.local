# -- tpm -----------------------------------------------------------------------

set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'
set -g @continuum-restore 'on'

# -- user customizations -------------------------------------------------------

# Increase history size
set -g history-limit 50000

# Use C-a prefix locally and C-b remotely
set -gu prefix2
unbind C-a
unbind C-b
if-shell '[ -n "$SSH_CLIENT" ] || [ -n "$SSH_TTY" ]' {
    # Remote/nested session
    set -g prefix C-b
    bind C-b send-prefix
    
    # Let the outer tmux or terminal handle mouse selection for clipboard copy
    set -g mouse off
} {
    # Local session
    set -g prefix C-a
    bind C-a send-prefix
}

# Navigate to left and right across windows
unbind C-h
unbind C-l
# -n: do no require the prefix, -r keeping key pressed repeats the command
bind -n -r C-k previous-window # select previous window
bind -n -r C-j next-window     # select next window

# Open new windows in the directory the session was started in
# (falls back to the current pane's directory if the session has no path)
unbind c
bind c new-window -c "#{session_path}" #!important

# Propagate Shift+Enter instead of intercepting it.
set -g extended-keys on
bind-key -n S-Enter send-keys "\e[13;2u"

# Enable system bell on macos
# enable bell monitoring (if not already)
set -g monitor-bell on

# Play macOS system sound on BEL character (async)
set -g monitor-bell on
if-shell 'uname | grep -q Darwin' \
  "set-hook -g alert-bell 'run-shell -b \"afplay /System/Library/Sounds/Glass.aiff >/dev/null 2>&1\"'" \
  "set-hook -gu alert-bell"

# Restore pane contents
set -g @resurrect-capture-pane-contents 'on'

# -- status bar ----------------------------------------------------------------

# Left: session name (no ❐ prefix) + compact uptime (no ↑ prefix)
#   >= 1d: 6d6h  |  < 1d: 7h3m, 0h30m
# Note: don't add #{uptime_y} here — upstream then rewrites uptime_d to days-mod-365.
setenv -g tmux_conf_theme_status_left ' #S | #{?uptime_d,#{uptime_d}d#{uptime_h}h,#{uptime_h}h#{uptime_m}m} '

# Right: no battery bar, no "|" sub-separators, time+date share one tile.
# In these strings "|" starts a new tile (cycling the fg/bg/attr lists below)
# and a top-level "," draws a sub-separator inside a tile — so there are none.
# The green on the percentage is what the bar's gradient used to bleed into it
# (it ended on colour82 and never reset); #[inherit] returns to the tile style.
# The clock tile is a dim amber LED read-out on near-black, with the date
# a shade darker than the time.
setenv -g tmux_conf_theme_status_right ' #{prefix}#{mouse}#{pairing}#{synchronized}#{?battery_status, #{battery_status},}#{?battery_percentage,#[fg=colour82] #{battery_percentage} #[inherit],}  | %R #[fg=#af8700]%d %b#[inherit] | #{username}#{root} | #{hostname} '

# Four tiles now (battery / clock / user / host), so extend the style lists.
setenv -g tmux_conf_theme_status_right_fg '#8a8a8a,#d78700,#e4e4e4,#080808'
setenv -g tmux_conf_theme_status_right_bg '#080808,#1c1c1c,#d70000,#e4e4e4'
setenv -g tmux_conf_theme_status_right_attr 'none,none,none,bold'
